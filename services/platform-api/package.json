{
  "name": "@game-center/platform-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:test": "tsx src/main.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx src/modules/catalog/infrastructure/persistence/scripts/migrate.ts",
    "db:status": "drizzle-kit check --config drizzle.config.ts",
    "db:seed": "tsx src/modules/catalog/infrastructure/persistence/scripts/seed.ts",
    "db:prepare": "npm run db:migrate && npm run db:seed",
    "lint": "oxlint src",
    "test": "vitest run \"src/**/*.spec.ts\"",
    "test:integration": "vitest run --config vitest.integration.config.mjs",
    "test:integration:docker": "vitest run --config vitest.docker.integration.config.mjs"
  },
  "dependencies": {
    "@game-center/contracts": "*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "dockerode": "^4.0.9",
    "drizzle-orm": "^0.44.5",
    "nats": "^2.29.3",
    "pg": "^8.16.3",
    "redis": "^5.8.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.39",
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.11",
    "nodemon": "^3.1.14",
    "oxlint": "^1.81.0",
    "tsx": "^4.20.5",
    "typescript": "~6.0.2"
  }
}
