REALTIME_WRITE_TIMEOUT_MS=3000
REALTIME_PLATFORM_TIMEOUT_MS=3000
REALTIME_READINESS_TIMEOUT_MS=1000
REALTIME_MAX_MESSAGE_BYTES=65536
REALTIME_MAX_OUTBOUND_QUEUE=64
REALTIME_RATE_LIMIT_MESSAGES_PER_SECOND=20
REALTIME_RATE_LIMIT_BURST=40
REALTIME_CONNECTION_TTL_MS=30000
REALTIME_REDIS_NAMESPACE=gc:v1:rt